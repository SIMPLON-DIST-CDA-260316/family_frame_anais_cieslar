generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Photo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  publicId  String
  pseudo    String
  // Dimensions après traitement Sharp (optionnelles : les anciennes photos ne les ont pas)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
